@model List<Pelicula>


<form method="get">
    <div class="row g-3 mb-4 align-items-center">
        @* filtro búsqueda *@
        <div class="input-group">
            <input name="txtBusqueda" value="@ViewBag.Consulta" type="text" class="form-control" placeholder="Buscar películas..." />
            <button type="submit" class="input-group-text">Buscar</button>
        </div>
        @* filtro género *@
        <div class="col">
            <select name="generoId" asp-items="@ViewBag.GeneroId" class="form-select form-select-lg btn-outline-secondary"
                    onchange="this.form.submit()">
            </select>
        </div>


    </div>

    @* listado de películas *@
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-4">
        @foreach (var pelicula in Model)
        {
            <div class="col">
                <a asp-action="Details" asp-route-id="@pelicula.Id">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="position-relative">
                            <img alt="@pelicula.Titulo" class="card-img-top" src="@pelicula.PosterUrlPortada" />
                        </div>
                        <div class="card-body p-2">
                            <h5 class="card-title fs-6 fw-semibold mb-1">@pelicula.Titulo</h5>
                            <div class="d-flex align-items-center text-muted small">
                                <span class="material-symbols-outlined text-warning me-1" style="font-size: 1rem;"> star </span>
                                <span>4.5</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</form>
<!-- Paginación -->
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Paginación" class="mt-4">
        <ul class="pagination justify-content-center">
            @if (ViewBag.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.PageNumber - 1)" asp-route-txtBusqueda="@ViewBag.Consulta" asp-route-generoId="@ViewBag.GeneroId">Anterior</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Anterior</span>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-txtBusqueda="@ViewBag.Consulta">@i</a>
                </li>
            }

            @if (ViewBag.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.PageNumber + 1)" asp-route-txtBusqueda="@ViewBag.Consulta" asp-route-generoId="@ViewBag.GeneroId">Siguiente</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Siguiente</span>
                </li>
            }
        </ul>
    </nav>
}

