@model IEnumerable<Peliculas_MVC.Models.Pelicula>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Titulo)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Genero)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Plataforma)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Titulo)
            </td>

            <td>
                @Html.DisplayFor(model => item.Genero.Descripcion)
            </td>

            <td>
                @Html.DisplayFor(model => item.Plataforma.Nombre)
            </td>

            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
